{
  "name": "invictae",
  "version": "0.3.0",
  "description": "Agentic cross-chain swap CLI \u2014 stables, native coins, and tokenized stocks across 12 chains, in one command.",
  "license": "MIT",
  "author": "ZuriLoop",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZuriLoop/invictae-cli.git"
  },
  "bin": {
    "invictae": "dist/cli/index.js",
    "invictae-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/cli",
    "prepublishOnly": "npm run build",
    "test": "node --test",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "11.1.0",
    "dotenv": "16.6.1",
    "ethers": "5.8.0"
  },
  "devDependencies": {
    "@types/node": "~18.18.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.4"
  },
  "keywords": [
    "cross-chain",
    "swap",
    "bridge",
    "defi",
    "cli",
    "usdc",
    "usdt",
    "cctp",
    "tokenized-stocks",
    "agents"
  ],
  "homepage": "https://github.com/ZuriLoop/invictae-cli#readme",
  "bugs": {
    "url": "https://github.com/ZuriLoop/invictae-cli/issues"
  }
}